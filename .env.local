# ClickClash — Local environment variables
# These are safe to commit for local dev; never put secrets here.

# URL of the Socket.IO server (running separately from Next.js)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ---- TURN server (Phase 6 — optional, improves NAT traversal) ----
# Leave blank for STUN-only (works on most home networks).
# For production, deploy coturn and fill in these values:
#   TURN_URLS=turn:your-turn-server.example.com:3478,turns:your-turn-server.example.com:5349
#   TURN_USERNAME=clickclash
#   TURN_PASSWORD=your_secure_password_here
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
